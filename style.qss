/* DARK THEME */
QMainWindow {
    background-color: #1e1e1e;
}

QWidget {
    background-color: #1e1e1e;
    color: #e0e0e0;
    font-family: 'Segoe UI';
}

#headerTitle {
    color: #4CAF50;
    font-size: 24px;
}

#inputFrame {
    background-color: #2d2d2d;
    border-radius: 10px;
    padding: 20px;
}

QPushButton {
    background-color: #4CAF50;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #45a049;
}

#removeButton, #clearButton {
    background-color: #f44336;
}

#removeButton:hover, #clearButton:hover {
    background-color: #da190b;
}

#themeButton {
    background-color: #2196F3;
}

#themeButton:hover {
    background-color: #0b7dda;
}

QLineEdit {
    background-color: #3d3d3d;
    border: 2px solid #555555;
    border-radius: 6px;
    padding: 8px;
    color: #e0e0e0;
    font-size: 12px;
}

QLineEdit:focus {
    border: 2px solid #4CAF50;
}

QComboBox {
    background-color: #3d3d3d;
    border: 2px solid #555555;
    border-radius: 6px;
    padding: 5px;
    color: #e0e0e0;
}

QComboBox:hover {
    border: 2px solid #4CAF50;
}

QComboBox::drop-down {
    border: none;
}

QTableWidget {
    background-color: #2d2d2d;
    alternate-background-color: #353535;
    border: 1px solid #555555;
    border-radius: 8px;
    gridline-color: #555555;
}

QTableWidget::item {
    padding: 8px;
    color: #e0e0e0;
}

QTableWidget::item:selected {
    background-color: #4CAF50;
}

QHeaderView::section {
    background-color: #3d3d3d;
    color: #e0e0e0;
    padding: 10px;
    border: none;
    font-weight: bold;
}

QLabel {
    color: #e0e0e0;
}

/* LIGHT THEME */
QMainWindow {
    background-color: #f5f5f5;
}

QWidget {
    background-color: #f5f5f5;
    color: #333333;
    font-family: 'Segoe UI';
}

#headerTitle {
    color: #4CAF50;
    font-size: 24px;
}

#inputFrame {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 10px;
    padding: 20px;
}

QPushButton {
    background-color: #4CAF50;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #45a049;
}

#removeButton, #clearButton {
    background-color: #f44336;
}

#removeButton:hover, #clearButton:hover {
    background-color: #da190b;
}

#themeButton {
    background-color: #2196F3;
}

#themeButton:hover {
    background-color: #0b7dda;
}

QLineEdit {
    background-color: white;
    border: 2px solid #e0e0e0;
    border-radius: 6px;
    padding: 8px;
    color: #333333;
    font-size: 12px;
}

QLineEdit:focus {
    border: 2px solid #4CAF50;
}

QComboBox {
    background-color: white;
    border: 2px solid #e0e0e0;
    border-radius: 6px;
    padding: 5px;
    color: #333333;
}

QComboBox:hover {
    border: 2px solid #4CAF50;
}

QComboBox::drop-down {
