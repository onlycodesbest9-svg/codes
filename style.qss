}

QTableWidget {
    background-color: white;
    alternate-background-color: #f9f9f9;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    gridline-color: #e0e0e0;
}

QTableWidget::item {
    padding: 8px;
    color: #333333;
}

QTableWidget::item:selected {
    background-color: #4CAF50;
    color: white;
}

QHeaderView::section {
    background-color: #f0f0f0;
    color: #333333;
    padding: 10px;
    border: none;
    font-weight: bold;
}

QLabel {
    color: #333333;
}
